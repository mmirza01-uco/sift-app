# Salin file ini menjadi .env lalu isi nilainya. Jangan pernah commit file .env.
# Bila FIREBASE_* kosong, aplikasi berjalan dalam MODE DEMO (tanpa login Firebase, data di memori).
# Bila OPENROUTER_API_KEY atau GEMINI_API_KEY kosong, aplikasi memakai AI TIRUAN.

PORT=3000

# --- AI ---
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Firebase ---
# Service account (Project settings > Service accounts > Generate new private key), JSON satu baris
FIREBASE_SERVICE_ACCOUNT=
# URL Realtime Database, contoh https://<project>-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DATABASE_URL=
# Konfigurasi web app (Project settings > Your apps > SDK setup), JSON satu baris
FIREBASE_WEB_CONFIG=

# --- Lain-lain ---
ALLOWED_ORIGIN=
DAILY_QUOTA=20
CACHE_TTL_DAYS=30
# DEMO_MODE=true memaksa mode demo, MOCK_AI=true memaksa AI tiruan, DEBUG_JEV=true mencetak response Jev
DEMO_MODE=
MOCK_AI=
DEBUG_JEV=
